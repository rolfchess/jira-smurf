JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token-from-id.atlassian.com
JIRA_PROJECT=PROJ

# Optional: override the story points field name (default: story_points)
# Common alternatives: customfield_10028, customfield_10016
# JIRA_STORY_POINTS_FIELD=story_points

# Optional: override the sprint field name (default: customfield_10020)
# JIRA_SPRINT_FIELD=customfield_10020

# Optional: comma-separated list of statuses to exclude from the export
# JIRA_EXCLUDE_STATUSES=Done,Cancelled

# Optional: highlight rules for HTML output (pipe-separated)
# Format: Column=Value:color|Column=Value:color
# Matching is case-insensitive. First matching rule wins.
# JIRA_HIGHLIGHT_RULES=Assignee=Your Name:yellow|Status=Blocked:#ffcccc
